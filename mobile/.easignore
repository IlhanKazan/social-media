# When this file exists, EAS Build uses it INSTEAD of .gitignore to decide
# what to upload. It mirrors .gitignore with one deliberate difference:
# google-services.json is NOT excluded here, so EAS Build receives it from
# local disk without it ever being committed to git.
#
# .env stays excluded on purpose — it holds local dev values
# (EXPO_PUBLIC_API_URL=http://localhost:8080). Build-time env for real builds
# comes from the `env` block in eas.json and from EAS environment variables.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# firebase: GoogleService-Info.plist (iOS) still excluded; google-services.json
# is intentionally allowed through for the Android build.
GoogleService-Info.plist

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
